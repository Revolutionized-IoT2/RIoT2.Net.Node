<Project>
  <!-- Central package versions (plan M8 step 2). Shared versions come from
       Revolutionized-IoT2/.github build/Directory.Packages.props.template. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Tests/LegacyPlugin: a plugin one target framework behind the node. -->
    <PackageVersion Include="RIoT2.Core.Devices" Version="2.4.0" />
    <PackageVersion Include="RIoT2.Core.Hosting" Version="2.4.0" />
    <PackageVersion Include="RIoT2.Core.Node" Version="2.4.0" />
  </ItemGroup>
</Project>
