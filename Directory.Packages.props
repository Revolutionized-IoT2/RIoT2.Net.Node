<Project>
  <!-- Central package versions (plan M8 step 2). Shared versions come from
       Revolutionized-IoT2/.github build/Directory.Packages.props.template. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="RIoT2.Core" Version="1.14.0" />
    <PackageVersion Include="RIoT2.Core.Hosting" Version="1.14.0" />
    <PackageVersion Include="RIoT2.Core.Node" Version="1.14.0" />
  </ItemGroup>
</Project>
