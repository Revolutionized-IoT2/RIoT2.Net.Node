
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-arm64v8 AS base
WORKDIR /app
# The health check needs wget, which the Ubuntu image doesn't have (the Alpine one has busybox).
RUN apt-get update \
    && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/*
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV ASPNETCORE_HTTP_PORTS=80
EXPOSE 80

# This stage is used to build the service project
FROM --platform=linux/amd64 mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG BUILD_CONFIGURATION=Release
ARG NUGET_URL=https://nuget.pkg.github.com/Revolutionized-IoT2/index.json
WORKDIR /src
COPY ["RIoT2.Net.Node.csproj", "Directory.Build.props", "Directory.Packages.props", "./"]
# The feed token is the BuildKit secret "nuget_token" and reaches NuGet only through an environment
# variable of this RUN, so no layer stores it:
#   docker buildx build --platform linux/arm64 -f Dockerfile_Arm64 --secret id=nuget_token,env=NUGET_AUTH_TOKEN .
RUN --mount=type=secret,id=nuget_token,required=true \
    dotnet nuget add source "$NUGET_URL" -n riot2 \
    && NuGetPackageSourceCredentials_riot2="Username=riot2;Password=$(cat /run/secrets/nuget_token)" \
       dotnet restore "./RIoT2.Net.Node.csproj" -a arm64
COPY . .
WORKDIR "/src/."
RUN dotnet build "./RIoT2.Net.Node.csproj" -c $BUILD_CONFIGURATION -a arm64 --no-restore -o /app/build

# This stage is used to publish the service project to be copied to the final stage
FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "./RIoT2.Net.Node.csproj" -c $BUILD_CONFIGURATION -a arm64 --no-restore -o /app/publish /p:UseAppHost=false

# This stage is used in production or when running from VS in regular mode (Default when not using the Debug configuration)
FROM base AS final
# Set by CI (.github docker-publish.yml); Data/Manifest.json shows them in the UI.
ARG VERSION=0.0.0-local
ARG IMAGE_TAG=ghcr.io/revolutionized-iot2/riot2-node:local-arm64v8
WORKDIR /app
COPY --from=publish /app/publish .
# The manifest lives outside Data/, because Data/ is a volume: a bind mount would hide the image's
# copy and a named volume would keep an old one. The entrypoint copies it into Data/ on every start.
RUN printf '{ "name": "RIoT2 Node (ARM64)", "date": "%s", "version": "%s", "installedPackageFilename": "%s" }\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%S)" "$VERSION" "$IMAGE_TAG" > /app/Manifest.json
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD wget -q -O- "http://127.0.0.1:${ASPNETCORE_HTTP_PORTS%%;*}/health" || exit 1
ENTRYPOINT ["/bin/sh", "-c", "mkdir -p /app/Data && cp /app/Manifest.json /app/Data/Manifest.json && exec dotnet RIoT2.Net.Node.dll \"$@\"", "riot2-node"]

#Set default environment variables
ENV ASPNETCORE_ENVIRONMENT=Production
ENV RIOT2_MQTT_IP=
ENV RIOT2_MQTT_PASSWORD=
ENV RIOT2_MQTT_USERNAME=
ENV RIOT2_NODE_ID=
ENV RIOT2_NODE_URL=
ENV TZ=Europe/Helsinki