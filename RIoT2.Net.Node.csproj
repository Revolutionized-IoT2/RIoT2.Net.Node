<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
	<InvariantGlobalization>true</InvariantGlobalization>
	<Configurations>Debug;Release;Local</Configurations>
	<NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Content Remove="Tests\**" />
    <None Remove="Tests\**" />
    <InternalsVisibleTo Include="RIoT2.Net.Node.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Properties\launchSettings.example.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RIoT2.Core" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Logs\" />
	<Folder Include="Data\" />
  </ItemGroup>

  <!-- Local runtime state is gitignored and must never reach publish output or an image
       (backlog item 20): Data holds the node configuration and the Firebase service account.
       Local plugins are copied to the build output for debugging, but never published. -->
  <ItemGroup>
    <Content Remove="Data\**;Logs\**;Plugins\**" />
    <None Remove="Data\**;Logs\**" />
    <None Update="Plugins\**\*.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
