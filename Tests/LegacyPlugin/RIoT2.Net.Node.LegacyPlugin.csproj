<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test fixture: a device plugin built against the node's previous target framework. The node
       tests load it to prove that plugins released before the node moved to net10.0 keep loading
       (plan M8, plugin release order). Keep this one TFM behind the node. It references
       RIoT2.Core.Devices of the node's Core major: the RIoT2.Core facade for plugins built before
       Core 1.13.0 is gone since Core 2.0.0 (I45), and the node refuses another major anyway. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RIoT2.Core.Devices" />
  </ItemGroup>
</Project>
